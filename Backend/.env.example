# Copy to Backend/.env and edit. Never commit the real .env.

DATABASE_URL=postgresql+psycopg2://atlas:atlas@localhost:5432/atlas

# Shared secrets. CHANGE BOTH before demoing on a shared network.
ADMIN_API_KEY=change-me-in-.env
DEVICE_API_KEY=change-me-device-key-in-.env

# --- Blockchain (local Hardhat devnet) ---
WEB3_RPC_URL=http://127.0.0.1:8545
# Hardhat's publicly documented account #0 key: test-only, holds no real value.
WEB3_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Printed by `npm run deploy` in blockchain/ -- paste it here.
CONTRACT_ADDRESS=
CHAIN_ENABLED=true
